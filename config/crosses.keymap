#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        ht: homerow_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB           &kp Q      &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I        &kp O    &kp P        &kp BSLH
&kp LSHFT         &kp A      &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K        &kp L    &kp ENTER    &kp APOS
&kp LCTRL         &lt 3 Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA    &kp DOT  &lt 3 SLASH  &kp ESC
                      &kp LGUI  &kp LALT  &kp SPACE        &lt 2 ENTER  &lt 2 BSPC    &kp SPACE
            >;
        };

        layer_1 {
            bindings = <
&trans    &kp N1  &kp N2  &kp N3  &kp N4  &trans      &trans  &kp F1   &kp F2   &kp F3   &kp F4   &trans
&trans    &kp N5  &kp N6  &kp N7  &kp N8  &trans      &trans  &kp F5   &kp F6   &kp F7   &kp F8   &trans
&trans    &kp N9  &kp N0  &trans  &trans  &trans      &trans  &kp F9   &kp F10  &kp F11  &kp F12  &trans
                      &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &trans      &trans  &kp F1   &kp F2   &kp F3   &kp F4   &trans
&trans    &kp PERCENT &kp CARET &kp AMPS  &kp STAR  &trans      &trans  &kp F5   &kp F6   &kp F7   &kp F8   &trans
&trans    &kp LPAR  &kp RPAR  &kp MINUS &kp EQUAL &trans      &trans  &kp F9   &kp F10  &kp F11  &kp F12  &trans
                      &trans  &trans  &trans        &trans  &trans  &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
&trans    &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &bt BT_CLR    &bt BT_CLR  &trans  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans
&trans    &trans        &trans        &trans  &trans  &trans        &trans      &trans  &trans        &trans        &trans        &trans
&trans    &trans        &trans        &trans  &trans  &trans        &trans      &trans  &trans        &trans        &trans        &trans
                      &mkp LCLK  &mkp MCLK  &mkp RCLK        &mkp RCLK  &mkp MCLK  &mkp LCLK
            >;
        };

    };
};
