#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        ht: homerow_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC     &kp Q   &kp W   &kp E   &kp R   &kp T        &kp Y   &kp U   &kp I     &kp O   &kp P   &kp DEL
&mo 3       &kp A   &kp S   &kp D   &kp F   &kp G        &kp H   &kp J   &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C   &kp V   &kp B        &kp N   &kp M   &kp COMMA &kp DOT  &kp FSLH &kp ENTER
                      &lt 3 LGUI &mo LEFT_GUI &kp SPACE   &kp BSPC &mo 2 &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &trans  &kp N1  &kp N2  &kp N3  &trans        &kp C_VOL_UP   &trans  &kp UP    &trans   &bt BT_CLR &bt BT_SEL 0
&kp TAB    &trans  &kp N4  &kp N5  &kp N6  &kp DEL       &kp C_VOL_DN   &kp DOWN &trans    &kp RIGHT &trans    &bt BT_SEL 1
&kp LSHFT  &trans  &kp N7  &kp N8  &kp N9  &kp BSPC      &trans         &trans   &trans    &trans    &trans    &bt BT_SEL 2
                       &trans  &trans  &kp N0  &trans      &trans &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp CARET  &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
&trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10       &kp MINUS  &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
&trans  &kp F11 &kp F12 &trans  &trans  &trans        &kp UNDER  &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                       &trans &trans &trans &trans     &trans &trans
            >;
        };

        layer_3 {
            bindings = <
&trans &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans &studio_unlock
&trans &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans      &trans  &trans  &trans  &trans  &trans &trans
&trans &trans  &trans     &trans     &trans     &trans      &trans  &trans  &trans  &trans  &trans &trans
                 &trans    &trans     &trans     &trans      &trans  &trans
            >;
        };
    };
};
